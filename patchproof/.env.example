# ---------------------------------------------------------------------------
# PatchProof configuration.
# Copy to `.env`. The pipeline and curated patches run with NO keys — these
# only enable AI-assisted patch generation (`patchproof run --ai`).
# ---------------------------------------------------------------------------

# Which provider the AI patcher uses: "gemini" or "groq".
PATCHPROOF_AI_PROVIDER=gemini

# --- Google Gemini (free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=

# --- Groq (free tier: https://console.groq.com/keys) ---
GROQ_API_KEY=
