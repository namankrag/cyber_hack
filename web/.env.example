# AgentShield website — server-side API proxy configuration.
# Copy to .env.local. Never expose keys in NEXT_PUBLIC_* variables.

# The FastAPI gateway. Keep this server-side; the browser only talks to /api.
AGENTSHIELD_API_URL=http://127.0.0.1:8000

# Optional gateway credentials. If the backend sets AGENTSHIELD_API_KEY /
# AGENTSHIELD_ADMIN_KEY, mirror them here. They stay in this server process
# and are forwarded as X-API-Key by the /api proxy.
AGENTSHIELD_API_KEY=
AGENTSHIELD_ADMIN_KEY=
# Password the browser operator signs in with on the Settings page. Verified
# server-side; the proxy issues an httpOnly signed session cookie for it.
# Privileged routes (v1/admin*, v1/approvals*, v1/redteam*) require that
# session. Never expose this or the keys above to the browser.
ADMIN_PASSWORD=
