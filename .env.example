# ---------------------------------------------------------------------------
# AgentShield configuration
# Copy this file to `.env` and fill in whichever keys you have.
# The ENFORCEMENT CORE RUNS WITHOUT ANY KEYS — these only enable the
# optional LLM-based detector and the demo agent's reasoning.
# ---------------------------------------------------------------------------

# Which detectors to run, comma-separated. "heuristic" needs no key.
# Add "llm" once you've set a provider key below.
AGENTSHIELD_DETECTORS=heuristic

# LLM detector provider: "gemini" or "groq"
AGENTSHIELD_LLM_PROVIDER=gemini

# --- Google Gemini (free tier via https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=

# --- Groq (free tier via https://console.groq.com/keys) ---
GROQ_API_KEY=

# Score (0.0-1.0) at/above which a detector result counts as a threat.
AGENTSHIELD_INJECTION_THRESHOLD=0.5

# Path to the active policy file.
AGENTSHIELD_POLICY_PATH=policies/default.yaml

# Where the audit trail is written (append-only JSONL).
AGENTSHIELD_AUDIT_PATH=audit.log.jsonl

# --- Security ---------------------------------------------------------------
# Secret used to mint/verify provenance tokens. Without it, the gateway runs in
# INSECURE DEV MODE (self-asserted source is honored; flagged in /v1/evidence)
# and the MCP "can't fake trust / replay" demo (POST /v1/trust/demo) returns
# 409 by design. SET THIS so trust can't be forged and that demo works.
# (The Docker image auto-generates an ephemeral one if you leave it blank;
# set it explicitly to persist tokens across restarts and share across replicas.)
AGENTSHIELD_HARNESS_SECRET=

# RAG embedding: "offline" (default) needs no model download and works
# air-gapped / in CI; "onnx" uses Chroma's model-based embedding (needs the
# model fetched/cached) for higher semantic quality.
# AGENTSHIELD_RAG_EMBEDDING=offline

# If set, every HTTP endpoint (incl. /v1/audit and /v1/evidence) requires header: X-API-Key: <value>
AGENTSHIELD_API_KEY=

# If set, /v1/admin/* requires THIS key instead of the API key, so a leaked
# read key cannot flip the global enforcement switch.
# AGENTSHIELD_ADMIN_KEY=

# Edge backstops (the platform edge does the real limiting/filtering).
# Requests per minute per IP (fixed window); 0 disables. Liveness probes
# (/health, /ready) are always exempt. Bodies over 256KB are rejected
# with 413 (fixed code budget, always on).
AGENTSHIELD_RATE_LIMIT_PER_MIN=600
# Set to 0 to close the interactive /docs + /openapi.json surface in prod.
AGENTSHIELD_ENABLE_DOCS=1

# Comma-separated argument keys to redact in the audit log (defaults cover the
# common ones: password, secret, token, api_key, authorization, ...).
# AGENTSHIELD_REDACT_KEYS=password,secret,token,api_key

# Timeout (seconds) for the optional LLM detector call.
AGENTSHIELD_LLM_TIMEOUT_S=8.0

# --- OpenAI-compatible LLM providers (all keyed, all optional) ---
# Provider name: AGENTSHIELD_LLM_PROVIDER=gemini|groq|openrouter|sarvam|nvidia|custom
# Model override for any provider (REQUIRED for openrouter; optional otherwise).
# AGENTSHIELD_LLM_MODEL=
# OpenRouter (https://openrouter.ai): one key, many models. No safe default.
OPENROUTER_API_KEY=
# Sarvam AI (India-focused models). Default model: sarvam-105b.
SARVAM_API_KEY=
# NVIDIA NIM (https://build.nvidia.com). Default model below; override if retired.
NVIDIA_API_KEY=
# Custom OpenAI-compatible endpoint (provider=custom). Both required.
# AGENTSHIELD_LLM_BASE_URL=https://llm.local/v1
# AGENTSHIELD_LLM_API_KEY=
