# ---------------------------------------------------------------------------
# AgentShield configuration
# Copy this file to `.env` and fill in whichever keys you have.
# The ENFORCEMENT CORE RUNS WITHOUT ANY KEYS — these only enable the
# optional LLM-based detector and the demo agent's reasoning.
# ---------------------------------------------------------------------------

# Which detectors to run, comma-separated. "heuristic" needs no key.
# Add "llm" once you've set a provider key below.
AGENTSHIELD_DETECTORS=heuristic

# LLM detector provider: "gemini" or "groq"
AGENTSHIELD_LLM_PROVIDER=gemini

# --- Google Gemini (free tier via https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=

# --- Groq (free tier via https://console.groq.com/keys) ---
GROQ_API_KEY=

# Score (0.0-1.0) at/above which a detector result counts as a threat.
AGENTSHIELD_INJECTION_THRESHOLD=0.5

# Path to the active policy file.
AGENTSHIELD_POLICY_PATH=policies/default.yaml

# Where the audit trail is written (append-only JSONL).
AGENTSHIELD_AUDIT_PATH=audit.log.jsonl
