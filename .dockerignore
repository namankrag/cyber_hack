# Keep the image lean and secret-free: COPY . . must not bake the local
# venv (526MB), git history, dev audit trail, caches, or a local .env.
.venv/
.git/
audit.log.jsonl
.env
.pytest_cache/
__pycache__/
*.pyc
*.egg-info/
docs/AgentShield_end_to_end.pdf
reports/
# The Next.js console deploys as its own service; the gateway image never
# needs it. Excluding it also keeps web/.env.local (admin password, keys)
# and ~500MB of node_modules out of local `docker build .` contexts.
web/
*.local
